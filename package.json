{
  "name": "cowcoming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "qa": "node scripts/verify.cjs",
    "qa:pointer": "node scripts/pointer-qa.cjs",
    "qa:niulai": "node scripts/niulai-qa.cjs",
    "qa:boot": "node scripts/boot-qa.cjs",
    "qa:world-niulai": "node scripts/world-niulai-qa.cjs",
    "qa:mouth": "node scripts/mouth-qa.cjs",
    "docs:sync": "node scripts/sync-product-doc.mjs",
    "qa:about": "node scripts/about-qa.cjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "relay:dev": "wrangler dev --config server/wrangler.jsonc --port 8794 --ip 127.0.0.1",
    "relay:deploy": "wrangler deploy --config server/wrangler.jsonc",
    "device:create": "node scripts/create-device.mjs",
    "test:relay": "node scripts/test-live.mjs",
    "qa:live": "node scripts/live-ui-qa.mjs",
    "qa:camera": "node scripts/local-camera-qa.mjs",
    "qa:device": "node scripts/live-python-qa.mjs",
    "test:relay:running": "node scripts/live-relay-check.mjs",
    "prebuild": "node scripts/export-device-kit.mjs",
    "predev": "node scripts/export-device-kit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.5.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.0",
    "vite": "^7.3.0",
    "wrangler": "4.58.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
