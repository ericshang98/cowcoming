# Optional. Leave blank for the truthful local archive / unsent contact state.
# POST {message, history} -> JSON {text}
VITE_CHAT_ENDPOINT=
# POST {intent, ...answers} -> JSON {delivered: true} only after confirmed delivery.
VITE_CONTACT_ENDPOINT=
# Public endpoint only. Never put a browser/device/admin key in VITE_*.
VITE_COWCOMING_RELAY_URL=
# Optional public GEV/GEP preview endpoint. It returns {requestId, actionId}
# where actionId is one of NOD, SHAKE, NOD_DOUBLE, TILT_LEFT, TILT_RIGHT, WAIT.
# Do not put a model/provider secret here; VITE_* values are shipped to browsers.
VITE_GEV_PREVIEW_URL=
# Local browser test gateway (run `npm run models:dev`). These are public
# loopback URLs only; configure real model credentials on the gateway process.
VITE_LLM_PREVIEW_URL=http://127.0.0.1:8768/v1/chat/completions
VITE_LLM_PREVIEW_MODEL=local-llm-fixture-v1

# Optional server-side model forwarding for `npm run models:dev`.
# GEV_MODEL_ENDPOINT=
# GEV_MODEL_NAME=
# GEV_MODEL_PROVIDER=openai-compatible
# GEV_MODEL_KEY=
# LLM_MODEL_ENDPOINT=
# LLM_MODEL_NAME=
# LLM_MODEL_PROVIDER=openai-compatible
# LLM_MODEL_KEY=
# EVOLUTION_MODEL_ENDPOINT=
# EVOLUTION_MODEL_NAME=
# EVOLUTION_MODEL_PROVIDER=openai-compatible
# EVOLUTION_MODEL_KEY=
