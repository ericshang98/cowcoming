# Optional. Leave blank for the truthful local archive / unsent contact state.
# POST {message, history} -> JSON {text}
VITE_CHAT_ENDPOINT=
# POST {intent, ...answers} -> JSON {delivered: true} only after confirmed delivery.
VITE_CONTACT_ENDPOINT=
# Public endpoint only. Never put a browser/device/admin key in VITE_*.
VITE_COWCOMING_RELAY_URL=
# Optional public GEV/GEP preview endpoint. It returns {requestId, actionId}
# where actionId is one of NOD, SHAKE, NOD_DOUBLE, TILT_LEFT, TILT_RIGHT, WAIT.
# Do not put a model/provider secret here; VITE_* values are shipped to browsers.
VITE_GEV_PREVIEW_URL=
